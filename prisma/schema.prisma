datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}



model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  name                 String?
  passwordHash         String
  isVerified           Boolean       @default(false)
  verificationToken    String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  refreshTokens        RefreshToken[]
  settings             UserSettings?
  periodLogs           PeriodLog[]
  symptomLogs          SymptomLog[]
  dailyCheckIns        DailyCheckIn[]
  pushSubscriptions    PushSubscription[]
  feedbacks            Feedback[]

  @@map("users")
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
  @@index([userId])
  @@index([token])
}

model UserSettings {
  id                             String   @id @default(uuid())
  userId                         String   @unique
  user                           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCycleLength             Int      @default(28)
  defaultPeriodLength            Int      @default(5)
  reminderPeriodDaysBefore       Int      @default(2)
  reminderNotificationsEnabled   Boolean  @default(true)
  theme                          String   @default("Calm")
  hasCompletedOnboarding         Boolean  @default(false)
  periodStress                   String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@map("user_settings")
}

model PeriodLog {
  id        String    @id @default(uuid())
  userId    String   
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate     DateTime 
  endDate       DateTime?
  flowIntensity String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("period_logs")
  @@index([userId, startDate])
}

model SymptomLog {
  id        String          @id @default(uuid())
  userId    String         
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime       
  category String
  type      String
  intensity Int?
  value     String?
  details String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("symptom_logs")
  @@index([userId, date])
  @@index([userId, category])
}

model DailyCheckIn {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  mood      Int?
  stress    Int?
  diet      Int?
  note      String?
  answers   String?
  
  // Expanded Symptom Logging
  moodString  String?
  symptoms    String?
  workouts    String?
  dietDetails String?

  // Sleep Logging
  sleepBedtime         String?
  sleepWakeTime        String?
  sleepDurationMinutes Int?
  sleepQuality         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_checkins")
  @@unique([userId, date])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // The Web Push subscription object data
  endpoint  String   @unique
  p256dh    String
  auth      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
  @@index([userId])
}

model Feedback {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  q1Rating         String
  q1Text           String?
  
  q2Rating         String
  q2Text           String?
  
  q3Rating         String
  q3Text           String?
  
  q4Rating         String
  q4Text           String?
  
  q5Rating         String
  q5Text           String?
  
  finalSuggestions String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("feedbacks")
  @@index([userId])
}
